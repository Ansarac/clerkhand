{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/dist", "!pnpm-lock.yaml"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      // Every stable group is fully on. Exceptions live in the overrides below,
      // each with its reason.
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "nursery": "off", // Unstable rules change between patch releases.
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "complexity": {
            // Conflicts with TS noPropertyAccessFromIndexSignature, which we keep because it
            // makes index-signature access (env vars, parsed JSON) visible at the call site.
            "useLiteralKeys": "off"
          },
          "correctness": {
            // Node-only CLI tools; there is no browser or edge runtime to stay portable to.
            "noNodejsModules": "off",
            // Qwik framework rule; this repo does not use Qwik.
            "useQwikValidLexicalScope": "off"
          },
          "performance": {
            // Polling and browser steps are sequential by design; running them in
            // parallel would be wrong.
            "noAwaitInLoops": "off"
          },
          "security": {
            "noSecrets": {
              "level": "error",
              // Teams type names, folder ids and CSS selectors trip the default (41).
              // Known token formats are still matched by pattern.
              "options": { "entropyThreshold": 60 }
            }
          },
          "style": {
            // Ternaries are idiomatic for expression-level choices; noNestedTernary stays on.
            "noTernary": "off",
            // Types and helpers sit next to the code that uses them.
            "useExportsLast": "off",
            // Teams ids contain ":" and "@"; getElementById needs no CSS escaping.
            "useDomQuerySelector": "off",
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    // Environment variable names (CLERKHAND_HOME) appear as object keys.
                    "selector": { "kind": "objectLiteralProperty" },
                    "formats": ["camelCase", "CONSTANT_CASE"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Biome's Markdown formatter inserts a blank line after the opening `---`
      // of YAML frontmatter, which breaks skill files.
      "includes": ["**/SKILL.md"],
      "formatter": { "enabled": false }
    },
    {
      // Page functions are serialized into the browser and cannot reference
      // module scope, so regexes stay inside them.
      "includes": ["packages/*/src/page/**"],
      "linter": { "rules": { "performance": { "useTopLevelRegex": "off" } } }
    },
    {
      // Package entry points exist to re-export the public API.
      "includes": ["packages/*/src/index.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      // Tool config files must use a default export.
      "includes": ["**/*.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["packages/*/test/**", "test/**"],
      "linter": {
        "rules": {
          // A describe block holds all cases for one unit.
          "complexity": { "noExcessiveLinesPerFunction": "off", "useMaxParams": "off" },
          "performance": { "useTopLevelRegex": "off" },
          "style": {
            // Tests assert on and stub the real environment.
            "noProcessEnv": "off",
            // Test data is literal by nature.
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          // CI scripts: printing progress and reading the Actions environment is their job.
          "suspicious": { "noConsole": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    }
  ]
}
